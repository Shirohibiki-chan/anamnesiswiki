# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Updater signing keys. The real one lives outside this repo (see
# docs/handoff.md -> Updates); this is insurance against one ever landing here.
*.key
*.key.pub

# Sandbox font downloads (regenerated by sandbox/build-fonts.mjs)
scripts/.font-cache/

# Electron build output (Phase 29). Hundreds of megabytes per build.
release/

# Written by the release workflow so the notes reach electron-builder as a
# file rather than as a command-line argument Windows would refuse.
release-notes.md

# Emitted by `tsc -b`, which is not how this repo typechecks (`pnpm build` runs
# a plain `tsc`). Four of these landed in a commit once; the build itself never
# wants them.
*.tsbuildinfo
vite.config.js
vite.config.d.ts
