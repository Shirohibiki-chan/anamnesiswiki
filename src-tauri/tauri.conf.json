{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anamnesis",
  "version": "0.5.0",
  "identifier": "com.anamnesis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anamnesis",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundColor": "#0f0f14",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Shirohibiki-chan/anamnesiswiki/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczMDI1N0FFNTQ4OTgxQzkKUldUSmdZbFVybGNDYzJ4MFJRNUxuU3hxeWVjZnoycWovMmFJUTJvWEdxRWNab0N1R0t4SzNtNlcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
