{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "store:default",
    "fs:read-all",
    "fs:write-all",
    "core:window:allow-destroy",
    "core:window:allow-show",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://assets.legendkeeper.com/*" }]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
