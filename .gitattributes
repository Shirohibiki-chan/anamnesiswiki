# cmd parses .bat files by byte offset, so LF-only endings mangle multi-line
# constructs -- and a mangled block doesn't error, it makes conditions quietly
# evaluate false. That cost several rounds of chasing a launcher that reported
# correctly-installed tools as missing. Force CRLF on checkout regardless of
# anyone's core.autocrlf.
*.bat text eol=crlf
*.cmd text eol=crlf

# Everything else: normalise in the repo, let git decide on checkout.
* text=auto
# Generated by scripts/build-fonts.mjs, thousands of lines, most of them a
# single base64 blob. A diff of one is unreadable and a merge of one is a
# mistake — regenerate instead.
sandbox/fonts.css -diff -merge
sandbox/fonts-library.css -diff -merge
src/fonts-library.css -diff -merge

# The bundled font files themselves. Marked explicitly so no eol normalisation
# can ever touch them, `* text=auto` above notwithstanding.
*.woff2 binary
